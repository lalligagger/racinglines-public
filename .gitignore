# --- Project data: NOTHING below may be committed ----------------------------------
# No data goes to git: not raw downloads (FastF1, ChronoRace, Polymarket), not derived
# tables, not test fixtures or golden baselines. Rebuild with:
#   racinglines <sport> fetch|download ...          (working data, see racinglines/paths.py)
#   python scripts/fetch_test_fixtures.py [--f1] [--mtb]   (test fixtures)
data/
tests/fixtures/
tests/golden/
*.parquet
*.npz
*.feather
*.arrow
*.sqlite
*.sqlite3
*.db
*.csv
*.pkl
*.pickle
*.joblib

# MkDocs build output
site/

