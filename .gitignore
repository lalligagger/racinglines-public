# --- Project data ------------------------------------------------------------------
# Data stays out of git, except the minimal set cloud sweep sessions need (allow-listed at the
# end of this file; the repo is private since 2026-09-27). Rebuild everything else with:
#   racinglines <sport> fetch|download ...          (working data, see racinglines/paths.py)
#   python scripts/fetch_test_fixtures.py [--f1] [--mtb]   (test fixtures)
data/*
tests/fixtures/
tests/golden/
*.parquet
*.npz
*.feather
*.arrow
*.sqlite
*.sqlite3
*.db
*.csv
*.pkl
*.pickle
*.joblib

# MkDocs build output
site/

# --- Python -------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
.python-version

# Test / type-check / lint caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.pytype/

# Jupyter
.ipynb_checkpoints/

# Environment / secrets
.env
.env.*

# --- Editors / OS -------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# --- Minimal data set for cloud sweeps (docs/cloud-sweep.md) --------------------------
# FastF1 raw files (F1) and the Polymarket prices/trades archive. Nothing else under data/.
# If this repo is ever made public, remove these from git history first.
!data/raw/
data/raw/*
!data/raw/f1/
!data/raw/f1/**
!data/archive/
data/archive/*
!data/archive/markets/
data/archive/markets/*
!data/archive/markets/polymarket/
data/archive/markets/polymarket/*
!data/archive/markets/polymarket/prices/
!data/archive/markets/polymarket/prices/**
!data/archive/markets/polymarket/trades/
!data/archive/markets/polymarket/trades/**
!data/archive/markets/polymarket/links/
!data/archive/markets/polymarket/links/**
!data/archive/db/
!data/archive/db/**
# search results brought back from cloud sessions (leaderboard, saved-run summaries, logs)
!data/runs/
data/runs/*
!data/runs/search/
!data/runs/search/**
