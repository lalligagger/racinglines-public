# --- Project data / generated output ----------------------------------------------
# Keep the repository code-only. Raw data, archives, run outputs, reports, build output,
# local cache files, and generated artifacts are never committed.

data/
reports/
site/
backtests/
results/
logs/
.claude/
.venv/
.pytest_cache/

