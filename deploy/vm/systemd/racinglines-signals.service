# The signal engine, one pass (replaces the Mac's LaunchAgent bet.racinglines.signals). Started by the .timer.
[Unit]
Description=racinglines F1 signals
After=network-online.target docker.service

[Service]
Type=oneshot
User=racinglines
WorkingDirectory=/opt/racinglines
EnvironmentFile=/etc/racinglines.env
ExecStart=/opt/racinglines/.venv/bin/racinglines f1 signals
