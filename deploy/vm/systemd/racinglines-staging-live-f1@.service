# Staging's own F1 live step for live/f1/<instance>.toml: the twin of racinglines-live-f1@, from
# /opt/racinglines-staging with /etc/racinglines-staging.env (its own data folder and database, no alerts).
#   bash scripts/deploy/vm.sh staging live <event> [off]
[Unit]
Description=racinglines live step (staging), F1 %i
After=network-online.target docker.service

[Service]
Type=oneshot
User=racinglines
WorkingDirectory=/opt/racinglines-staging
EnvironmentFile=/etc/racinglines-staging.env
ExecStart=/opt/racinglines-staging/.venv/bin/racinglines live step live/f1/%i.toml
