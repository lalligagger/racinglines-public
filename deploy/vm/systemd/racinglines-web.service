# racinglines.bet's web app on the VM (docs/vm-deploy.md). cloudflared forwards the domain to 127.0.0.1:8000.
[Unit]
Description=racinglines web app
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=racinglines
WorkingDirectory=/opt/racinglines
EnvironmentFile=/etc/racinglines.env
ExecStart=/opt/racinglines/.venv/bin/racinglines web
Restart=always
RestartSec=5
# The server cancels in-flight requests 10 s after SIGTERM (uvicorn timeout_graceful_shutdown); this is the margin
# above that before systemd would SIGKILL, instead of the 90 s default that each restart used to wait out.
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
