# NASCAR and MotoGP forecast refresh timer, one pass (scripts/vm/forecast-refresh.sh). Started by the .timer; enabled by vm.sh forecast.
# Logs: journalctl -u racinglines-forecast-refresh, and data/runs/logs/forecast-refresh.log
[Unit]
Description=racinglines NASCAR and MotoGP forecast refresh
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=racinglines
WorkingDirectory=/opt/racinglines
ExecStart=/opt/racinglines/scripts/vm/forecast-refresh.sh
TimeoutStartSec=30min
StandardOutput=journal
StandardError=journal
SyslogIdentifier=racinglines-forecast-refresh
Environment=PYTHONUNBUFFERED=1
