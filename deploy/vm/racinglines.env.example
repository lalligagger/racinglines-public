# /etc/racinglines.env on the VM: owned by root, mode 640, group racinglines (setup.sh creates it from this file).
# Fill in the blanks by hand. Never commit the filled-in copy.
DATABASE_URL=postgresql+psycopg://racinglines:racinglines@127.0.0.1:5433/racinglines
RACINGLINES_DATA=/opt/racinglines/data
RACINGLINES_URL=https://racinglines.bet
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# a long random string (openssl rand -hex 32), so sign-ins survive restarts; the MCP server signs its OAuth sign-ins with it too
APP_SECRET=
RACINGLINES_NTFY_TOPIC=
ALERT_WEBHOOK_URL=
# the MCP server (racinglines-mcp.service, off unless enabled): accounts sign in from their MCP client, or get a token in Settings;
# roles allowed to hold one (default admin; e.g. admin,maker to open it to makers)
RACINGLINES_MCP_ROLES=admin
# Command output is Rich (colour, tables, a few emojis) by default (racinglines/cli/tty.py). Under systemd the units'
# output goes to the journal (JOURNAL_STREAM is set) and the CLI drops every escape code on its own, so journalctl
# never shows "[N blob data]"; layout and emojis stay. NO_COLOR=1 does the same in every context (ssh, cron);
# RACINGLINES_PLAIN=1 prints the plain text of before.
#NO_COLOR=1
