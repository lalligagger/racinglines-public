# /etc/racinglines.env on the VM: owned by root, mode 640, group racinglines (setup.sh creates it from this file).
# Fill in the blanks by hand. Never commit the filled-in copy.
DATABASE_URL=postgresql+psycopg://racinglines:racinglines@127.0.0.1:5433/racinglines
RACINGLINES_DATA=/opt/racinglines/data
RACINGLINES_URL=https://racinglines.bet
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# a long random string (openssl rand -hex 32), so sign-ins survive restarts
APP_SECRET=
RACINGLINES_NTFY_TOPIC=
ALERT_WEBHOOK_URL=
# the MCP server's bearer token (racinglines-mcp.service, off unless enabled): openssl rand -hex 32
RACINGLINES_MCP_TOKEN=
