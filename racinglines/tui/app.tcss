/* Layout only: colours come from the pitwall theme, meaning from fmt.py. */
Screen { layout: vertical; }
#tabs { height: 1fr; }
TabPane { padding: 0 1; }

.toolbar { height: auto; padding: 0 0 0 0; }
.toolbar > Input { width: 1fr; }
.toolbar > Select { width: 1fr; max-width: 60; }
.toolbar > .narrow { width: 16; max-width: 16; }
.toolbar > Button { margin: 0 0 0 1; min-width: 10; }
.toolbar > .hint { width: 1fr; padding: 0 0 0 2; }

.muted { color: $text-muted; }
.section { text-style: bold; padding: 1 0 0 0; }

KeyValues { height: auto; padding: 0 0 0 1; }
DataGrid { border: round $panel; height: 1fr; }
DataGrid:focus { border: round $secondary; }
DataGrid > .datatable--header { text-style: bold; color: $text-muted; background: $surface; }
DataGrid > .datatable--cursor { background: $secondary 30%; }

Sparkline { height: 6; margin: 0 0 1 0; }
Sparkline > .sparkline--max-color { color: $secondary; }
Sparkline > .sparkline--min-color { color: $primary 40%; }

/* Keep cell colours on the cursor row: green/red still mean something there. */
DataGrid > .datatable--cursor { text-style: bold; }
.toolbar { margin: 0 0 1 0; }
.toolbar > Select { max-width: 56; }
.toolbar > CButton, .toolbar > Button { margin: 0 0 0 1; }
.form-row { margin: 0 0 1 0; }
